{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "decisions",
    "change"
  ],
  "properties": {
    "contractVersion": {
      "const": "rules-engine-play-change.v1"
    },
    "decisions": {
      "type": "object"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "enum": [
            "rest",
            "spend-hit-die",
            "toggle-feature",
            "select-spell",
            "cast-spell"
          ]
        },
        "rest": {
          "enum": [
            "short",
            "long"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "enabled": {
          "type": "boolean"
        },
        "classId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "selection": {
          "enum": [
            "cantrips",
            "spellbook",
            "preparedSpells"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "slot": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
