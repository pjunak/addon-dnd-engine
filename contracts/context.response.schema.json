{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "engineContract", "engineContractVersion",
    "available", "status", "identity", "errors"
  ],
  "properties": {
    "contractVersion": { "const": "rules-engine-context.v1" },
    "engineContract": { "const": "dnd5e.rules-engine" },
    "engineContractVersion": { "const": "3.0.0" },
    "available": { "type": "boolean" },
    "status": { "enum": ["ready", "missing", "unavailable", "incompatible", "stale"] },
    "identity": { "$ref": "provider-identity.schema.json#/$defs/identity" },
    "errors": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
