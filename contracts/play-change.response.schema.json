{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "sheet",
    "warnings",
    "available",
    "status",
    "decisions",
    "errors"
  ],
  "properties": {
    "contractVersion": {
      "const": "rules-engine-play-result.v1"
    },
    "sheet": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 200
    },
    "identity": {
      "$ref": "provider-identity.schema.json#/$defs/identity"
    },
    "available": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "decisions": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 200
    }
  }
}
